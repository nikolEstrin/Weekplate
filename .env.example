# Only the Supabase publishable/anon key belongs in the client. Never use the service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Public HTTPS URL of the hosted privacy policy (docs/PRIVACY_POLICY.md). Shown in Settings.
VITE_PRIVACY_POLICY_URL=https://example.com/weekplate/privacy

# Development only (`npm run dev`): run without Supabase using a local user and no sync.
# Ignored by production builds.
# VITE_DEV_LOCAL_ONLY=true
